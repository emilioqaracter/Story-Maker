{
  "env": {
    "TRACE_TO_LANGFUSE": "true",
    "LANGFUSE_BASE_URL": "https://cloud.langfuse.com",
    "LANGFUSE_TRACING_ENVIRONMENT": "desarrollo"
  },
  "permissions": {
    "allow": [
      "Bash(claude -p:*)"
    ]
  },
  "enabledPlugins": {
    "langfuse-observability@langfuse-observability": true
  }
}
