        <mxCell id="automejora" value="&lt;b&gt;6 · EL LOOP DE AUTOMEJORA&lt;/b&gt; — skill &lt;i&gt;automejora&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#4A5763&quot;&gt;una vuelta por turno: una novela, una cuenta, una regla&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;1. lanza una novela de control en su propia sesión&lt;br&gt;2. cuenta cuántos capítulos entran a la primera&lt;br&gt;3. agrupa los &lt;b&gt;Leccion:&lt;/b&gt; de los jueces y toma el más repetido&lt;br&gt;4. lo convierte en una regla de &lt;b&gt;.claude/agents/redactor.md&lt;/b&gt;&lt;br&gt;5. lo anota en la bitácora y lo commitea (revertible)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9F5;strokeColor=#F4631E;dashed=1;fontColor=#1E2D3D;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1460" y="60" width="360" height="210" as="geometry" />
        </mxCell>

        <mxCell id="capas" value="&lt;b&gt;Capas que se pueden apagar&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#4A5763&quot;&gt;la taxonomía, leída por lo que pasa si quitas cada cosa&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;el plan&lt;/b&gt; → sin él no hay novela&lt;br&gt;&lt;br&gt;&lt;b&gt;las decisiones en disco&lt;/b&gt; → se escribe a ciegas&lt;br&gt;&lt;br&gt;&lt;b&gt;el revisor&lt;/b&gt; → entra todo&lt;br&gt;&lt;br&gt;&lt;b&gt;el verificador&lt;/b&gt; → los capítulos se contradicen&lt;br&gt;&lt;br&gt;&lt;b&gt;el director&lt;/b&gt; → el turno se decide leyendo la carpeta&lt;br&gt;&lt;br&gt;&lt;b&gt;Langfuse&lt;/b&gt; → las decisiones siguen enteras&lt;br&gt;&lt;br&gt;&lt;b&gt;el tablero (ui/)&lt;/b&gt; → el sistema no se entera&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D0D0D0;fontColor=#1E2D3D;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1460" y="330" width="360" height="300" as="geometry" />
        </mxCell>

        <mxCell id="nunca" value="&lt;b&gt;Los invariantes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#4A5763&quot;&gt;lo que sostiene la arquitectura entera&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;· &lt;b&gt;Ningún agente aprueba su propio trabajo&lt;/b&gt;, y el orquestador tampoco puede decidir que un capítulo está bien.&lt;br&gt;&lt;br&gt;· &lt;b&gt;El estado es la carpeta.&lt;/b&gt; Escribir la decisión &lt;i&gt;es&lt;/i&gt; decidir; renombrar el borrador &lt;i&gt;es&lt;/i&gt; aprobar.&lt;br&gt;&lt;br&gt;· &lt;b&gt;El tablero no orquesta&lt;/b&gt; y no escribe un byte en books/ ni en .claude/.&lt;br&gt;&lt;br&gt;· &lt;b&gt;Una luz roja nunca se resume:&lt;/b&gt; al redactor le llega la ruta y la lee entera.&lt;br&gt;&lt;br&gt;· &lt;b&gt;Tres intentos y se para.&lt;/b&gt; Decide la persona.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E2D3D;fontColor=#1E2D3D;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1">
