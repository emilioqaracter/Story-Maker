{
  "name": "story-maker-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Entrevista del brief, lectura por versiones y vistas de estado de Story-Maker. Spec: specs/srs-frontend-v1.md",
  "scripts": {
    "gen": "openapi-typescript ../backend/openapi.json -o commons/api/schema.d.ts --default-non-nullable false",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "gate": "node gate.mjs"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "fast-check": "4.10.2",
    "jsdom": "26.1.0",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
