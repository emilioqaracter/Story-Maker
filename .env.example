# Observabilidad en Langfuse. TODO ESTO ES OPCIONAL: sin claves, el harness
# corre igual y la traza local (reports/traza.jsonl) sigue siendo la que manda.
#
# Copia este archivo a `.env` y pega tus claves. `.env` esta en .gitignore y
# NO se commitea nunca: las claves son de tu proyecto, no del repo.
#
#   cp .env.example .env
#
# Las claves salen de Langfuse > Settings > API Keys (proyecto, no organizacion).
LANGFUSE_PUBLIC_KEY=pk-lf-TU_CLAVE_PUBLICA
LANGFUSE_SECRET_KEY=sk-lf-TU_CLAVE_SECRETA

# La region donde vive tu proyecto. EU por defecto; descomenta la que uses.
LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_HOST=https://us.cloud.langfuse.com
# LANGFUSE_HOST=https://jp.cloud.langfuse.com

# Separa las corridas de prueba de las de verdad en los dashboards.
LANGFUSE_TRACING_ENVIRONMENT=development
